# Choose one or both providers
# Replace the placeholder values with your real API keys.
# Example: ANTHROPIC_API_KEY=sk-ant-your-real-key
# Example: OPENAI_API_KEY=sk-your-real-key
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
# Leave empty to use the official OpenAI API.
OPENAI_BASE_URL=

# Default model
DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
